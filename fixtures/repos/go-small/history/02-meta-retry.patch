@@ -0,0 +1,64 @@
+package meta
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+)
+
+const kokoro = `{"ISBN:9784101010137": {"title": "こころ", "authors": ["夏目漱石"], "pages": 248}}`
+
+func TestFetchMetadata_RetriesOnce(t *testing.T) {
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		if calls.Add(1) == 1 {
+			http.Error(w, "boom", http.StatusInternalServerError)
+			return
+		}
+		w.Write([]byte(kokoro))
+	}))
+	defer srv.Close()
+
+	md, err := NewClient(srv.URL).Fetch(context.Background(), "978-4-10-101013-7")
+	if err != nil {
+		t.Fatalf("Fetch: %v", err)
+	}
+	if md.Title != "こころ" {
+		t.Errorf("title = %q", md.Title)
+	}
+	if got := calls.Load(); got != 2 {
+		t.Errorf("calls = %d; want 2 (one attempt + exactly one retry)", got)
+	}
+
+	// A second failure is not retried again.
+	calls.Store(0)
+	down := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		calls.Add(1)
+		http.Error(w, "down", http.StatusBadGateway)
+	}))
+	defer down.Close()
+	if _, err := NewClient(down.URL).Fetch(context.Background(), "9784101010137"); err == nil {
+		t.Fatal("Fetch against a dead catalogue succeeded")
+	}
+	if got := calls.Load(); got != 2 {
+		t.Errorf("calls against a dead catalogue = %d; want 2", got)
+	}
+}
+
+func TestFetchMetadata_NoRetryOnSuccess(t *testing.T) {
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		calls.Add(1)
+		w.Write([]byte(kokoro))
+	}))
+	defer srv.Close()
+
+	if _, err := NewClient(srv.URL).Fetch(context.Background(), "9784101010137"); err != nil {
+		t.Fatalf("Fetch: %v", err)
+	}
+	if got := calls.Load(); got != 1 {
+		t.Errorf("calls = %d; want 1", got)
+	}
+}
