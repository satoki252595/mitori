datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Book {
  id      Int      @id @default(autoincrement())
  isbn    String   @unique
  title   String
  status  String   @default("unread")
  addedAt DateTime @default(now())
}
