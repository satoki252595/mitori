+/** Mean amount of the invoices in one currency (0 when there are none). */
+export function average(invoices: readonly Invoice[], currency: Invoice["currency"]): number {
+  const own = invoices.filter((invoice) => invoice.currency === currency);
+  return own.length === 0 ? 0 : own.reduce((sum, invoice) => sum + invoice.amount, 0) / own.length;
+}
