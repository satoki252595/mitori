  "portableSetup": {
    "sourceServer": {
      "command": "<absolute existing Bun >=1.4.2>",
      "args": [
        "<absolute mitori checkout>/scripts/start.ts",
        "mcp",
        "--repo",
        "<absolute target repo>"
      ]
    },
    "cursor": {
      "configFile": ".cursor/mcp.json or ~/.cursor/mcp.json",
      "config": {
        "mcpServers": {
          "mitori": {
            "type": "stdio",
            "command": "<absolute Bun>",
            "args": [
              "<absolute mitori>/scripts/start.ts",
              "mcp",
              "--repo",
              "<absolute target repo>"
            ]
          }
        }
      },
      "verify": "cursor-agent --workspace <absolute target repo> mcp list-tools mitori"
    },
    "grok": {
      "register": "grok mcp add mitori -- <absolute Bun> <absolute mitori>/scripts/start.ts mcp --repo <absolute target repo>",
      "verify": "grok --cwd <absolute target repo> mcp doctor mitori --json"
    },
    "codex": {
      "register": "codex mcp add mitori -- <absolute Bun> <absolute mitori>/scripts/start.ts mcp --repo <absolute target repo>",
      "configOnlyVerify": "codex mcp get mitori",
      "noInferenceProtocol": {
        "command": "codex app-server --stdio",
        "requests": [
          {
            "id": 1,
            "method": "initialize",
            "params": {
              "clientInfo": {
                "name": "mitori_native_mcp_probe",
                "version": "0.0.0"
              }
            }
          },
          {
            "method": "initialized"
          },
          {
            "id": 2,
            "method": "mcpServerStatus/list",
            "params": {
              "serverName": "mitori"
            }
          }
        ]
      }
    },
    "antigravity": {
      "configFile": "~/.gemini/config/mcp_config.json or .agents/mcp_config.json",
      "config": {
        "mcpServers": {
          "mitori": {
            "command": "<absolute Bun>",
            "args": [
              "<absolute mitori>/scripts/start.ts",
              "mcp",
              "--repo",
              "<absolute target repo>"
            ]
          }
        }
      },
      "configOnlyVerify": "agy mcp list",
      "requiredHumanAction": "Open official app Manage MCP Servers or CLI /mcp, reload mitori, and confirm available tools; model/session generation remains unverified",
      "register": "agy mcp add mitori -- <absolute Bun> <absolute mitori>/scripts/start.ts mcp --repo <absolute target repo>",
      "registrationVerifiedOnTemporarySettings": true,
      "registrationIncludedSpaceInTargetPath": true
