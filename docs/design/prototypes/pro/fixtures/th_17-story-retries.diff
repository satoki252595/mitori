+// DefaultStoryRetries keeps the historical "retry exactly once" behavior.
+const DefaultStoryRetries = 1
+
+// MaxStoryRetries bounds agent_cmd re-runs per `crit story` (cost guard).
+const MaxStoryRetries = 3
+
+// StoryRetriesOrDefault returns how many times `crit story` re-asks the agent
+// after an unparseable answer. Unset falls back to DefaultStoryRetries.
+func (c Config) StoryRetriesOrDefault() int {
+	if c.StoryRetries == nil {
+		return DefaultStoryRetries
+	}
+	return min(max(*c.StoryRetries, 0), MaxStoryRetries)
+}
