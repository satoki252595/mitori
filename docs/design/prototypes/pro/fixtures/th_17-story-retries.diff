+func generateStory(agentCmd, guide string, maxRetries int) (*session.Story, error) {
+	prompt := story.BuildStoryPrompt(guide, storySchemaJSON, "")
+	var out string
+	var parseErr error
+	for attempt := 0; attempt <= maxRetries; attempt++ {
+		o, err := execAgentCmd(agentCmd, prompt)
