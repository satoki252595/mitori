+// DefaultStoryMaxRetries is the retry budget when story_max_retries is unset.
+const DefaultStoryMaxRetries = 1
+
+// StoryRetries returns the effective retry budget for `crit story`, clamped to [0, 3].
+func (c Config) StoryRetries() int {
+	if c.StoryMaxRetries == nil {
+		return DefaultStoryMaxRetries
+	}
+	return min(max(*c.StoryMaxRetries, 0), 3)
