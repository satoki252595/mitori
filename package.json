{
  "name": "mitori-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*",
    "bench",
    "eval",
    "e2e",
    "fixtures"
  ],
  "scripts": {
    "check": "bun scripts/check.ts",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "check:web": "svelte-check --workspace apps/web --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "bun test",
    "golden": "bun scripts/golden.ts",
    "fixtures:build": "bun fixtures/build.ts",
    "corpus:fetch": "bun scripts/fetch-corpus.ts",
    "budgets:merge": "bun scripts/budgets-merge.ts",
    "bench": "bun scripts/run-owned.ts bench/runner/run.ts:WP-12",
    "bench:compare": "bun scripts/run-owned.ts bench/compare/compare.ts:WP-12",
    "e2e": "bun scripts/run-owned.ts e2e/harness/run.ts:WP-12",
    "eval": "bun scripts/run-owned.ts eval/run.ts:WP-12",
    "contract-test": "bun scripts/run-owned.ts bench/contract/run.ts:WP-05",
    "build:bin": "bun scripts/build-bin.ts",
    "size": "bun scripts/run-owned.ts apps/cli/src/build/size.ts:WP-11a bench/asset/size.ts:WP-12",
    "contract:index": "bun scripts/contract-index.ts",
    "briefs": "bun scripts/gen-briefs.ts",
    "ci:pr": "bun run check && bun run test && bun run fixtures:build --verify && bun run golden && bun run size"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "miniflare": "5.20261001.0-alpha",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  },
  "trustedDependencies": []
}
