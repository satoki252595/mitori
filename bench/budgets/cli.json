{
  "v": "mitori.budgets/1",
  "budgets": [
    {
      "id": "bin.size",
      "metric": "単一バイナリのサイズ（fine-grained Shiki 前提）",
      "target": 85,
      "limit": 95,
      "unit": "MB",
      "dir": "max",
      "gates": ["absolute"],
      "owner": "cli",
      "measure": "bench/asset/size.ts#bin-size",
      "scale": "none",
      "provisional": false
    },
    {
      "id": "bin.startup",
      "metric": "mitori --version の起動（hyperfine 20 回の median）",
      "target": 20,
      "limit": 50,
      "unit": "ms",
      "dir": "max",
      "gates": ["absolute"],
      "owner": "cli",
      "measure": "bench/asset/size.ts#bin-startup",
      "scale": "machine",
      "provisional": false
    },
    {
      "id": "bin.health",
      "metric": "mitori <go-small> --no-open の起動 → GET /api/v1/health 応答（node_modules の無い dir、compiled、cold home。MILESTONES WP-00 受け入れ・SKEL-AT-01）",
      "target": 1000,
      "limit": 1000,
      "unit": "ms",
      "dir": "max",
      "gates": ["absolute"],
      "owner": "cli",
      "measure": "bench/server.bench.ts#bin-health",
      "scale": "machine",
      "provisional": false
    }
  ]
}
